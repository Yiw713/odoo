<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_type_list" model="ir.ui.view">
    <field name="name">company.event.type.list</field>
    <field name="model">company.event.type</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="color"/>
        </list>
    </field>
</record>

    <record id="view_event_type_form" model="ir.ui.view">
        <field name="name">company.event.type.form</field>
        <field name="model">company.event.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_type" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">company.event.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>