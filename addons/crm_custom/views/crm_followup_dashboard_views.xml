<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot View -->
    <record id="crm_followup_dashboard_pivot" model="ir.ui.view">
        <field name="name">crm.followup.dashboard.pivot</field>
        <field name="model">crm.followup.dashboard</field>
        <field name="arch" type="xml">
            <pivot string="Followup Dashboard">
                <field name="user_id" type="row"/>
                <field name="status" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="crm_followup_dashboard_graph" model="ir.ui.view">
        <field name="name">crm.followup.dashboard.graph</field>
        <field name="model">crm.followup.dashboard</field>
        <field name="arch" type="xml">
            <graph string="Followup Dashboard" type="bar">
                <field name="user_id"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="crm_followup_dashboard_action" model="ir.actions.act_window">
        <field name="name">Followup Dashboard</field>
        <field name="res_model">crm.followup.dashboard</field>
        <field name="view_mode">pivot,graph</field>
    </record>

    <!-- Menu -->
    <menuitem id="crm_followup_dashboard_menu"
              name="Followup Dashboard"
              parent="crm_followup_root"
              action="crm_followup_dashboard_action"
              sequence="20"/>

</odoo>
