<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="crm_followup_list_view" model="ir.ui.view">
        <field name="name">crm.followup.list</field>
        <field name="model">crm.followup</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="user_id"/>
                <field name="followup_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="crm_followup_form_view" model="ir.ui.view">
        <field name="name">crm.followup.form</field>
        <field name="model">crm.followup</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="lead_id"/>
                        <field name="user_id"/>
                        <field name="followup_date"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="crm_followup_action" model="ir.actions.act_window">
        <field name="name">Follow Ups</field>
        <field name="res_model">crm.followup</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="crm_followup_root"
              name="Follow Ups"
              parent="crm.crm_menu_root"
              sequence="50"/>

    <menuitem id="crm_followup_menu"
              name="All Follow Ups"
              parent="crm_followup_root"
              action="crm_followup_action"/>
              
</odoo>
