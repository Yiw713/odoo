<odoo>
    <record id="view_crm_report_form" model="ir.ui.view">
        <field name="name">crm.report.form</field>
        <field name="model">mono.crm.report</field>
        <field name="arch" type="xml">
            <form string="CRM Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button name="action_generate_report"
                            string="Generate"
                            type="object"
                            class="btn-primary"/>
                </footer>

                <group string="Summary">
                    <field name="total_leads"/>
                    <field name="total_won"/>
                    <field name="total_activities"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_crm_report" model="ir.actions.act_window">
        <field name="name">CRM Summary</field>
        <field name="res_model">mono.crm.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_crm_report"
              name="CRM Report"
              parent="crm.crm_menu_root"
              action="action_crm_report"/>
</odoo>