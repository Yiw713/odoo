<odoo>

    <record id="mono_api_list" model="ir.ui.view">
    <field name="name">mono.api.list</field>
    <field name="model">mono.api.data</field>
    <field name="arch" type="xml">
        <list>
            <header>
                <button name="action_refresh"
                        type="object"
                        string="Save API Data"
                        class="btn-primary"/>
            </header>

            <field name="vehicle_id"/>
            <field name="vehicle_name"/>
            <field name="timestamp"/>
            <field name="speed"/>
            <field name="status"/>
            <field name="engine_status"/>
        </list>
    </field>
</record>

    <record id="mono_api_form" model="ir.ui.view">
    <field name="name">mono.api.form</field>
    <field name="model">mono.api.data</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_refresh"
                        type="object"
                        string="Save API Data"
                        class="btn-primary"/>
            </header>

            <sheet>
                <group>
                    <field name="vehicle_id"/>
                    <field name="vehicle_name"/>
                    <field name="timestamp"/>
                    <field name="speed"/>
                    <field name="status"/>
                    <field name="engine_status"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="mono_api_action" model="ir.actions.act_window">
        <field name="name">API Data</field>
        <field name="res_model">mono.api.data</field>
        <field name="view_mode">list,form</field>
    </record>
    

</odoo>