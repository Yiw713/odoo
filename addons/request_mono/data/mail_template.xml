<odoo>
    <record id="email_template_request" model="mail.template">
        <field name="name">Request Notification</field>
        <field name="model_id" ref="model_mono_request"/>
        <field name="subject">Request Update</field>
        <field name="body_html">
            <![CDATA[
                <p>Request: ${object.name}</p>
                <p>Status: ${object.state}</p>
            ]]>
        </field>
    </record>
</odoo>