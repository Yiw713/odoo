<odoo>

    <!-- TREE -->
    <record id="view_tree_request" model="ir.ui.view">
        <field name="name">mono.request.tree</field>
        <field name="model">mono.request</field>
        <field name="arch" type="xml">
            <list>
    <field name="name"/>
    <field name="employee_id"/>
    <field name="request_type"/>
    <field name="state"/>
</list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_form_request" model="ir.ui.view">
        <field name="name">mono.request.form</field>
        <field name="model">mono.request</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>

    <button name="action_submit" string="Submit" type="object"
        invisible="state != 'draft'"/>

    <button name="action_manager_approve" string="Manager Approve" type="object"
        invisible="state != 'submitted'"/>

    <button name="action_hr_approve" string="HR Approve" type="object"
        invisible="state != 'manager'"/>

    <button name="action_done" string="Done" type="object"
        invisible="state != 'hr'"/>

    <button name="action_reject" string="Reject" type="object"
        invisible="state == 'done'"/>

    <field name="state" widget="statusbar"/>

</header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="request_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="reason"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_request" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">mono.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_mono_root" name="Request Mono"/>
    <menuitem id="menu_request" name="Requests" parent="menu_mono_root" action="action_request"/>

</odoo>